# Copy this file to .env and fill in the secrets below.
# Everything here is a placeholder. Never commit your real .env.

# --- Secrets (REQUIRED) -----------------------------------------------------
# AP_ENCRYPTION_KEY must be exactly 32 hex characters:  openssl rand -hex 16
# Keep it safe: without it, saved connections cannot be decrypted after a restore.
AP_ENCRYPTION_KEY=
# Long random values:  openssl rand -hex 32
AP_JWT_SECRET=
AP_API_KEY=
POSTGRES_PASSWORD=

# --- Where Activepieces is reached ------------------------------------------
# Local trial (default): http://localhost:8080
# With HTTPS and your own domain: AP_FRONTEND_URL=https://flows.example.com
# This URL is used to build webhook and OAuth redirect URLs, so it must be the
# address the outside world uses.
AP_FRONTEND_URL=http://localhost:8080

# --- Misc ---------------------------------------------------------------------
# Host port on 127.0.0.1 that maps to Activepieces.
HOST_PORT=8080
# Anonymous product analytics. Set to true to opt in.
AP_TELEMETRY_ENABLED=false
