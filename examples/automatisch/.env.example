# Copy this file to .env and fill in the secrets below.
# Everything here is a placeholder. Never commit your real .env.

# --- Secrets (REQUIRED) -----------------------------------------------------
# Generate each one with:  openssl rand -hex 32
# Keep ENCRYPTION_KEY safe: without it, saved connections cannot be decrypted
# after a restore. Do not change it once connections have been saved.
ENCRYPTION_KEY=
WEBHOOK_SECRET_KEY=
APP_SECRET_KEY=
POSTGRES_PASSWORD=

# --- Where Automatisch is reached -------------------------------------------
# Local trial (default): http://localhost:3000
# With HTTPS and your own domain, for example:
#   AUTOMATISCH_HOST=automations.example.com
#   AUTOMATISCH_PROTOCOL=https
#   WEB_APP_URL=https://automations.example.com
#   WEBHOOK_URL=https://automations.example.com
AUTOMATISCH_HOST=localhost
AUTOMATISCH_PROTOCOL=http
WEB_APP_URL=http://localhost:3000
WEBHOOK_URL=http://localhost:3000

# --- Misc ---------------------------------------------------------------------
# Host port on 127.0.0.1 that maps to Automatisch.
HOST_PORT=3000
# Anonymous telemetry. Set to true to opt in.
TELEMETRY_ENABLED=false
