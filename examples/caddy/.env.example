# Copy this file to .env and edit the three values. No secrets are needed.

# A domain you own. Its DNS A/AAAA record must point at this machine, and ports
# 80 and 443 must be reachable from the internet (needed to get the certificate).
DOMAIN=app.example.com

# Where the app listens on this machine (the port is the HOST_PORT of the app):
#   n8n 127.0.0.1:5678      Activepieces 127.0.0.1:8080   Automatisch 127.0.0.1:3000
#   Huginn 127.0.0.1:3000   Node-RED 127.0.0.1:1880
UPSTREAM=127.0.0.1:5678

# Contact address given to the certificate authority (Let's Encrypt).
ACME_EMAIL=you@example.com
