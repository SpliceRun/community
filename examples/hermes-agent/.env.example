# Copy this file to .env and fill in the values below.
# Everything here is a placeholder. Never commit your real .env.
# Hermes Agent is made by Nous Research; this is an unofficial example.

# --- Your model provider key (REQUIRED) -------------------------------------
# Create a key in your own OpenRouter account and set a spending limit there.
# The example does not start without it. Using another provider: see the README.
OPENROUTER_API_KEY=

# --- Dashboard login (REQUIRED) ---------------------------------------------
# Choose your own username and a long password. The password is stored in plain text
# in this file; keep the file private (chmod 600 .env).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Signs the dashboard session. Generate with:  openssl rand -hex 32
DASHBOARD_SESSION_SECRET=

# --- Internal health-check key (REQUIRED) -----------------------------------
# Hermes requires a key for its internal API server. Generate with:  openssl rand -hex 32
API_SERVER_KEY=

# --- Misc ---------------------------------------------------------------------
# Host port on 127.0.0.1 that maps to the dashboard.
HOST_PORT=9119
TZ=UTC
