# Copy this file to .env and fill in the values below.
# Everything here is a placeholder. Never commit your real .env.

# --- Secrets (REQUIRED) -----------------------------------------------------
# Generate each one with:  openssl rand -hex 32
APP_SECRET_TOKEN=
POSTGRES_PASSWORD=
# Password of the first (admin) account, created only on first start.
# Choose a long random one:  openssl rand -base64 24
SEED_PASSWORD=
# People need this code to sign up. Generate one:  openssl rand -hex 8
INVITATION_CODE=

# --- Admin account name (first start only) ------------------------------------
SEED_USERNAME=admin

# --- Where Huginn is reached ------------------------------------------------
# Local trial (default): DOMAIN=localhost:3000 and FORCE_SSL=false
# With HTTPS and your own domain:
#   DOMAIN=huginn.example.com
#   FORCE_SSL=true
DOMAIN=localhost:3000
FORCE_SSL=false

# --- Misc ---------------------------------------------------------------------
# Host port on 127.0.0.1 that maps to Huginn.
HOST_PORT=3000
TIMEZONE=UTC
# Route agent web requests through the bundled egress proxy (meant to block private
# and link-local targets; not tested). Set to false only if agents must reach your LAN.
ENABLE_SMOKESCREEN=true
