# Copy this file to .env and fill in the two secrets below.
# Everything here is a placeholder. Never commit your real .env.

# --- Secrets (REQUIRED) -----------------------------------------------------
# Generate each one with:  openssl rand -hex 32
# Keep N8N_ENCRYPTION_KEY safe: without it, saved credentials cannot be decrypted
# after a restore. Do not change it once n8n has stored credentials.
N8N_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# --- Where n8n is reached -----------------------------------------------------
# Local trial (default): http://localhost:5678
# Behind HTTPS with your own domain, for example:
#   N8N_HOST=n8n.example.com
#   N8N_PROTOCOL=https
#   N8N_EDITOR_BASE_URL=https://n8n.example.com
#   WEBHOOK_URL=https://n8n.example.com/
#   N8N_PROXY_HOPS=1
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
# Number of reverse proxies in front of n8n (0 = none, 1 = the Caddy example).
N8N_PROXY_HOPS=0

# --- Misc ---------------------------------------------------------------------
# Host port on 127.0.0.1 that maps to n8n.
HOST_PORT=5678
TZ=UTC
# n8n sends anonymous usage diagnostics unless this is false.
N8N_DIAGNOSTICS_ENABLED=false
