# Copy this file to .env and fill in the values below.
# Everything here is a placeholder. Never commit your real .env.

# --- Editor login (REQUIRED) --------------------------------------------------
NODE_RED_ADMIN_USER=admin
# Choose a long random password:  openssl rand -base64 24
NODE_RED_ADMIN_PASSWORD=

# --- Encryption of stored credentials (REQUIRED) -------------------------------
# Generate with:  openssl rand -hex 32
# Keep it safe. Do not change it once flows with credentials exist, or the stored
# credentials can no longer be read.
NODE_RED_CREDENTIAL_SECRET=

# --- Misc ---------------------------------------------------------------------
# Host port on 127.0.0.1 that maps to Node-RED.
HOST_PORT=1880
TZ=UTC
